<%layout('/layouts/biolerplate')-%>

  <body>
<style>
  /* Container for the filter icons and arrows */
  .filters-container {
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden; /* Keeps buttons from bleeding out */
  }

  .filters {
    display: flex;
    align-items: center;
    overflow-x: auto;
    scroll-behavior: smooth;
    white-space: nowrap;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
  }

  .filters::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  .filter {
    text-align: center;
    margin-right: 2rem;
    margin-top: 1rem;
    opacity: 0.7;
    flex: 0 0 auto; 
    cursor: pointer;
  }

  .filter:hover { opacity: 1; }
  .filter p { font-size: 0.8rem; margin-bottom: 0; }

  /* Navigation Arrow Styling */
  .arrow-btn {
    background-color: white;
    border: 1px solid #b2b2b2;
    border-radius: 50%;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
  }

  .tax-toggle {
    border: 1px solid #b2b2b2;
    border-radius: 1rem;
    height: 3.25rem;
    padding: 1rem;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }
</style>

<div class="d-flex align-items-center justify-content-between px-3 mt-3">
  
  <div class="filters-container flex-grow-1 me-3">
    <div class="arrow-btn me-2" onclick="scrollFilters(-200)">
      <i class="fa-solid fa-chevron-left"></i>
    </div>

    <div class="filters" id="filters-scroll">
      <div class="filter"><i class="fa-solid fa-fire"></i><p>Trending</p></div>
      <div class="filter"><i class="fa-solid fa-bed"></i><p>Rooms</p></div>
      <div class="filter"><i class="fa-solid fa-mountain-city"></i><p>Cities</p></div>
      <div class="filter"><i class="fa-solid fa-mountain"></i><p>Mountains</p></div>
      <div class="filter"><i class="fa-solid fa-fort-awesome"></i><p>Castles</p></div>
      <div class="filter"><i class="fa-solid fa-person-swimming"></i><p>Pools</p></div>
      <div class="filter"><i class="fa-solid fa-campground"></i><p>Camping</p></div>
      <div class="filter"><i class="fa-solid fa-cow"></i><p>Farming</p></div>
      <div class="filter"><i class="fa-solid fa-snowflake"></i><p>Arctic</p></div>
      <div class="filter"><i class="fa-solid fa-landmark-dome"></i><p>Dome</p></div>
      <div class="filter"><i class="fa-solid fa-snowflake"></i><p>Arctic</p></div>
      <div class="filter"><i class="fa-solid fa-landmark-dome"></i><p>Dome</p></div>
    </div>

    <div class="arrow-btn ms-2" onclick="scrollFilters(200)">
      <i class="fa-solid fa-chevron-right"></i>
    </div>
  </div>

  <div class="tax-toggle">
    <div class="form-check form-switch form-check-reverse">
      <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault">
      <label class="form-check-label" for="flexSwitchCheckDefault">Display Total after Taxes</label>
    </div>
  </div>
</div>

    <div class="row row-cols-lg-3 row-col-md-2 row-cols-sm-1 mt-3">
      <%for(list of AllListing) {%>
        <a href="/listings/<%=list._id%>" class="listing-link">
          <div class="card col listing-card">
            <img src="<%=list.image.url%>" class="card-img-top" alt="Listing" style="height: 20rem;">
            <div class="card-img-overlay">abc</div>
            <div class="card-body">
              <p class="card-text">
                <b>
                  <%= list.title %>
                </b><br>
                &#x20B9; <%= list.price ? list.price.toLocaleString("en-IN") : "Price not available" %> / night
                <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
              </p>
            </div>
          </div>
        </a>
        <%}%>
    </div>
    <script>
      let taxSwitch = document.getElementById("flexSwitchCheckDefault");
      taxSwitch.addEventListener("click",()=>{
        let taxInfo = document.getElementsByClassName("tax-info");
       for(info of taxInfo){
        if(info.style.display != "inline"){
          info.style.display = "inline";
        }else{
          info.style.display = "none";
        }
       }
      })
 
  function scrollFilters(val) {
    let container = document.getElementById("filters-scroll");
    container.scrollLeft += val;
  }

    </script>